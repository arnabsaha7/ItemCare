{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ItemCare",
  "version": "../package.json",
  "identifier": "com.itemcare.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ItemCare",
        "width": 1440,
        "height": 1000,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; worker-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/ItemCare/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "Your Personal Home & Asset Command Center",
    "longDescription": "Local-first Windows desktop command center for household assets, warranties, maintenance schedules, property documentation, and encrypted insurance packs.",
    "copyright": "Copyright (c) 2026 ItemCare",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxMjI0NUQ4NkI3RjVCQTkKUldTcFczOXIyRVVpVVFRU0lsWFVCY0hMR0QvT2hUSElkc1V5L2F5cDNkdnhzOWluREVBYUZvalUK",
      "endpoints": [
        "https://github.com/arnabsaha7/ItemCare/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}