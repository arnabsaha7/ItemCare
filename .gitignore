# ─── Dependencies ─────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build output ─────────────────────────────
dist/
dist-ssr/
build/
*.local

# ─── Rust / Tauri ─────────────────────────────
src-tauri/target/
src-tauri/gen/
**/*.rs.bk

# ─── Environment & secrets ────────────────────
.env
.env.*
!.env.example
*.pem
*.key
.env.example

